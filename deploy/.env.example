# MoreAni 部署环境变量模板 — 复制为 deploy/.env 并填写
# 生成密钥: openssl rand -hex 32

# 必填：JWT 签名密钥（不设置 docker compose 会拒绝启动）
SECRET_KEY=

# 可选：CORS 白名单（逗号分隔，默认 localhost + moreani.lovelysia.top）
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://moreani.lovelysia.top

# 可选：Cloudflare Tunnel token
# CF_TUNNEL_TOKEN=
