# MoreAni 部署环境变量模板 — 复制为 deploy/.env 并填写
# 生成密钥: openssl rand -hex 32

# 必填：JWT 签名密钥（不设置 docker compose 会拒绝启动）
SECRET_KEY=

# 仅首次运行 backend/scripts/manage_users.py init 时临时设置；至少 12 位。
# 初始化完成后无需保留，切勿提交真实值。
MOREANI_BOOTSTRAP_ADMIN_PASSWORD=

# 生产环境 CORS 白名单（逗号分隔，默认仅公网 HTTPS 域名）
# ALLOWED_ORIGINS=https://moreani.lovelysia.top

# 可信反向代理网段（仅这些来源的 X-Forwarded-For 会被采信）
# TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128,172.16.0.0/12

# 生产 Cookie 必须 Secure；本地 HTTP 开发可设为 false
# MOREANI_COOKIE_SECURE=true

# 可选：Cloudflare Tunnel token
# CF_TUNNEL_TOKEN=
