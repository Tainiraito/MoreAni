# MoreAni Backend 环境变量
# 复制此文件为 .env 并修改

# JWT 签名密钥（生产环境必须设置，每次部署使用固定值）
# 生成方式: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# 仅首次运行 scripts/manage_users.py init 创建管理员时需要，至少 12 位
MOREANI_BOOTSTRAP_ADMIN_PASSWORD=

# 数据库路径（默认 SQLite）
# DATABASE_URL=sqlite:///./moreani.db

# Bangumi 新番周历每日同步（生产部署默认开启）
# MOREANI_AIRING_CALENDAR_WORKER=false

# 周历封面后台预热（失败时仍保留外链代理降级）
# MOREANI_AIRING_COVER_PREFETCH=false
# MOREANI_AIRING_COVER_CONCURRENCY=4
# MOREANI_AIRING_COVER_MAX_BYTES=8388608
# MOREANI_COVER_ORPHAN_RETENTION_DAYS=365
# MOREANI_COVER_CLEANUP_ENABLED=false

# 图片代理单独限流，避免封面失败重试占用普通 API 额度
# MOREANI_RATE_LIMIT_IMAGE=120
# MOREANI_RATE_LIMIT_IMAGE_WINDOW_SECONDS=60
# MOREANI_PROXY_IMAGE_MAX_BYTES=8388608
